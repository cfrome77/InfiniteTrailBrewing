# Sanity.io Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_CONTACT_EMAIL="hello@yourdomain.com"
# Required. The dataset must be private; without a token every read fails.
SANITY_API_TOKEN="your-api-token"

# Shared secret for the Sanity -> /api/revalidate webhook (HMAC-SHA256).
# Revalidation is refused when this is unset.
SANITY_REVALIDATE_SECRET="generate-a-random-secret"

# Fourthwall shop url
NEXT_PUBLIC_FOURTHWALL_SHOP_URL="https://shop.yourdomain.com"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"
CONTACT_RECEIVING_EMAIL="hello@yourdomain.com"

# Admin access (required for /admin/studio and privileged Server Actions)
# ADMIN_SESSION_SECRET must be at least 32 characters. Generate with:
#   openssl rand -base64 48
ADMIN_LOGIN_PASSWORD="choose-a-strong-staff-password"
ADMIN_SESSION_SECRET="generate-a-random-32-plus-character-secret"
