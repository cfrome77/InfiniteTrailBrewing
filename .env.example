# Sanity.io Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_CONTACT_EMAIL="hello@yourdomain.com"
SANITY_API_TOKEN="your-api-token"

# Sanity webhook signature secret (Project settings -> API -> Webhooks).
# Must match the secret configured on the /api/revalidate webhook.
SANITY_REVALIDATE_SECRET="your-webhook-secret"

# Fourthwall shop url
NEXT_PUBLIC_FOURTHWALL_SHOP_URL="https://shop.yourdomain.com"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"
# Address contact-form mail is delivered to.
CONTACT_RECEIVING_EMAIL="hello@yourdomain.com"
# Verified Resend sender. Must be a domain you have verified in Resend.
CONTACT_FROM_EMAIL="noreply@mail.yourdomain.com"

# Staff access for /admin (Sanity Studio + inventory/newsletter tools)
ADMIN_USERNAME="your-username"
# Preferred. Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
ADMIN_PASSWORD_HASH="scrypt:<salt-hex>:<hash-hex>"
# Fallback for local development only; leave unset in production.
# ADMIN_PASSWORD="your-password"
# Signs the admin session cookie. Must be at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET="at-least-32-random-characters"
